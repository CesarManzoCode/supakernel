      "ok": true
    },
    {
      "target": "deno (pglite + fs, Deno.serve)",
      "name": "data: A inserts an owned row (WITH CHECK passes)",
      "ok": true
    },
    {
      "target": "deno (pglite + fs, Deno.serve)",
      "name": "data: A reads back exactly its own row",
      "ok": true
    },
    {
      "target": "deno (pglite + fs, Deno.serve)",
      "name": "data: an anon insert is rejected (default-deny)",
      "ok": true
    },
    {
      "target": "deno (pglite + fs, Deno.serve)",
      "name": "data: A updates its row title",
      "ok": true
    },
    {
      "target": "deno (pglite + fs, Deno.serve)",
      "name": "auth: sign up + sign in user B",
      "ok": true
    },
    {
      "target": "deno (pglite + fs, Deno.serve)",
      "name": "data: B cannot see A rows (row-level isolation)",
      "ok": true
    },
    {
      "target": "deno (pglite + fs, Deno.serve)",
      "name": "data: B cannot insert a row owned by A (WITH CHECK)",
