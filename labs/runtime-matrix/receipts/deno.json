    },
    {
      "target": "deno (pglite + fs, Deno.serve)",
      "name": "storage: A round-trips an object through a bucket",
      "ok": true
    },
    {
      "target": "deno (pglite + fs, Deno.serve)",
      "name": "data: A deletes its row",
      "ok": true
    },
    {
      "target": "deno (pglite + fs, Deno.serve)",
      "name": "auth: A signs out; the token no longer authenticates",
      "ok": true
