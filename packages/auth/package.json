{
  "name": "@supakernel/auth",
  "version": "0.0.0",
  "private": true,
  "description": "GoTrue-compatible Auth subset: users, password, JWT, API keys, sessions, refresh rotation, admin (contract §12, §30 L6)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit"
  },
  "sideEffects": false,
  "dependencies": {
    "@supakernel/contracts": "workspace:*",
    "@supakernel/ports": "workspace:*",
    "jose": "6.2.11"
  },
  "devDependencies": {
    "@supakernel/contracts": "workspace:*",
    "@supakernel/ports": "workspace:*",
    "@supakernel/db-postgres": "workspace:*",
    "@supakernel/db-sqlite": "workspace:*",
    "@supabase/supabase-js": "2.115.0",
    "@types/node": "24.13.3",
    "vitest": "5.0.0"
  }
}
