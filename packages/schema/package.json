{
  "name": "@supakernel/schema",
  "version": "0.0.0",
  "private": true,
  "description": "SchemaIR, PG AST parse, normalize, diff, plan, apply, journal, dialects, introspection",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit"
  },
  "sideEffects": false,
  "dependencies": {
    "@supakernel/contracts": "workspace:*",
    "@supakernel/ports": "workspace:*"
  },
  "devDependencies": {
    "libpg-query": "17.7.4",
    "@types/node": "24.13.3",
    "vitest": "5.0.0",
    "@supakernel/ports-test": "workspace:*",
    "@supakernel/db-sqlite": "workspace:*",
    "@supakernel/db-pglite": "workspace:*",
    "@supakernel/db-postgres": "workspace:*",
    "@supakernel/contracts": "workspace:*"
  }
}
